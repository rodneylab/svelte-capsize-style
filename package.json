{
	"name": "svelte-capsize-style",
	"version": "0.0.1",
	"license": "BSD-3-Clause",
	"description": "Svelte Capsize styling: how you can use the Capsize typography tooling with SvelteKit to layout text predictably in your ❤️ Svelte app.",
	"scripts": {
		"dev": "vite dev",
		"start": "vite dev",
		"build": "vite build",
		"package": "svelte-kit package",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "playwright test",
		"lint": "prettier --check --plugin=prettier-plugin-svelte --plugin=@trivago/prettier-plugin-sort-imports . && eslint .",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"check:formatting": "prettier --check --plugin=prettier-plugin-svelte --plugin=@trivago/prettier-plugin-sort-imports .",
		"format": "prettier --ignore-path .gitignore --write --plugin=prettier-plugin-svelte --plugin=@trivago/prettier-plugin-sort-imports ."
	},
	"devDependencies": {
		"@capsizecss/core": "^4.1.2",
		"@capsizecss/metrics": "^3.5.0",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/js": "^9.33.0",
		"@fontsource/abril-fatface": "^5.2.6",
		"@fontsource/courier-prime": "^5.2.6",
		"@playwright/test": "^1.54.2",
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/kit": "^2.28.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.1",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"commitlint": "^19.8.1",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.3.0",
		"husky": "^9.1.7",
		"postcss-html": "^1.8.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"stylelint": "^16.23.1",
		"stylelint-config-recommended": "^17.0.0",
		"stylelint-config-standard": "^39.0.0",
		"svelte": "^5.38.1",
		"svelte-check": "^4.3.1",
		"typescript": "~5.9.2",
		"typescript-eslint": "^8.39.1",
		"vite": "^7.1.2"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/rodneylab/svelte-capsize-styling"
	},
	"bugs": {
		"url": "https://github.com/rodneylab/svelte-capsize-styling/issues"
	},
	"dependencies": {
		"eslint-plugin-svelte": "^3.11.0"
	}
}
